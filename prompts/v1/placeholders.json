    "{LEVEL}": "engine: condition level",
    "{TRIGGER_TS}": "engine: latched first-trigger timestamp",
    "{TRIGGER_PRICE}": "engine: latched trigger price",
    "{THESIS_TEXT}": "engine: archived thesis text",
    "{REASON_LIST}": "engine: fixed rejection strings from blocks.md",
    "{SIZE}": "engine: rejected size_usd value",
    "{MAX}": "engine: 5 x equity value at validation time"
