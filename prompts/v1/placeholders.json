    "{DAILY_CLOSES}": "engine: 40 real contiguous Kraken daily closes",
    "{EQUITY}": "engine: Decimal equity frozen at T",
    "{POSITION_BLOCK}": "blocks.md :: POSITION_BLOCK",
    "{FEES_TOTAL}": "engine: cumulative fees (Decimal)",
    "{MAX_NOTIONAL}": "engine: 5 x equity at T (Decimal)",
    "{TRADES_BLOCK}": "blocks.md :: TRADES_BLOCK",
    "{CONDITION_BLOCK}": "blocks.md :: CONDITION_BLOCK",
    "{MEMORY_BLOCK}": "blocks.md :: MEMORY_BLOCK",
    "{RSI_H}": "engine indicator (TA template only): hourly RSI(14)",
    "{MACD_LINE}": "engine indicator (TA only): MACD line",
    "{MACD_SIGNAL}": "engine indicator (TA only): MACD signal",
    "{MACD_HIST}": "engine indicator (TA only): MACD histogram",
    "{BB_UP}": "engine indicator (TA only): Bollinger upper",
    "{BB_MID}": "engine indicator (TA only): Bollinger middle",
    "{BB_LOW}": "engine indicator (TA only): Bollinger lower",
    "{SMA20_H}": "engine indicator (TA only): hourly SMA20",
    "{SMA50_H}": "engine indicator (TA only): hourly SMA50",
    "{ATR_H}": "engine indicator (TA only): hourly ATR14",
    "{SMA20_D}": "engine indicator (TA only): daily SMA20",
    "{RSI_D}": "engine indicator (TA only): daily RSI14"
  },
  "blocks": {
    "{SIDE}": "engine: long|short",
    "{QTY}": "engine: absolute quantity (qty_decimals, rounded down)",
