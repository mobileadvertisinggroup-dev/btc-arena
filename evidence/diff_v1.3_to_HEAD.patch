+                 boundary=expected["T"], done=expected["done"],
+                 total=expected["total"], lifecycle=expected["lifecycle"],
+                 publication_id=expected["publication_id"],
+                 payload_sha256=hashlib.sha256(text.encode()).hexdigest())
