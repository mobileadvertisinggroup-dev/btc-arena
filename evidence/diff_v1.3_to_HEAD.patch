++    fee_open = Decimal("5000") * Decimal("0.0005")
++    q2 = Decimal("72.727272")
++    dq = q2 - q1
++    fee_inc = dq * Decimal("110") * Decimal("0.0005")
++    e2 = (q1 * e1 + dq * Decimal("110")) / q2
++    q3 = Decimal("25")
++    red = q2 - q3
