++class VClock:
++    def __init__(self):
++        self.t = 0.0
++
++    def __call__(self):
++        return self.t
++
++    def sleep(self, s):
++        self.t += s
++
++
++def _remote_text(pub_id):
++    return f'window.ARENA_LIVE = {json.dumps({"publication_id": pub_id})};\n'
++
