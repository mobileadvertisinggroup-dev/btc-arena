+                out = rounds.collect_one(caller, a, snap, cfg, tctx, pregen,
+                                         writer, budget_ok)
+                return aid, out, clock()
+            with ThreadPoolExecutor(max_workers=concurrency) as ex:
+                futs = [ex.submit(task, aid) for aid in sorted(live_tasks)]
