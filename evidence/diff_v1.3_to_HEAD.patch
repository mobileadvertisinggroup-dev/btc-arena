+.tcard .grid b{color:var(--ink)}
+.pnl.up{color:var(--up)} .pnl.down{color:var(--down)} .pnl.zero{color:var(--mut)}
+/* sections below */
+section{margin-top:26px}
+.rulehead{border-bottom:3px solid var(--rule);display:flex;
+  justify-content:space-between;align-items:baseline;padding-bottom:6px;
+  margin-bottom:14px}
+.rulehead h2{font-size:17px;font-weight:800;letter-spacing:2px}
+.rulehead .sub{color:var(--mut);font-size:12px}
+.twrap{overflow-x:auto;border:1px solid var(--hair);background:var(--panel)}
+table{border-collapse:collapse;width:100%;font-size:13px;min-width:680px}
+th{background:var(--chrome);color:var(--ink);text-align:left;font-weight:700;
+  letter-spacing:1px;font-size:11px;padding:8px 12px;
+  border-bottom:2px solid var(--rule)}
+td{padding:7px 12px;border-bottom:1px solid var(--hair);
+  font-variant-numeric:tabular-nums;white-space:nowrap}
+tr:last-child td{border-bottom:none}
+.up{color:var(--up)} .down{color:var(--down)}
+.mdot{display:inline-block;width:10px;height:10px;margin-right:7px}
+footer{border-top:3px solid var(--rule);margin-top:30px;padding:16px 0 34px;
+  color:var(--mut);font-size:12px}
+@media (max-width:1020px){
+  .main{grid-template-columns:1fr}
+  .panel{position:static;max-height:560px}
+  .strip{grid-template-columns:repeat(3,1fr)}
+  .brand .t1{font-size:24px}
+  .cell.mkt .v{font-size:17px}
+}
