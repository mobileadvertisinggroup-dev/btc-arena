+++++"""Crash & idempotency matrix (Ruling 005.5) over the checkpointed runner."""
+++++import json
+++++
+++++import pytest
+++++
+++++from conftest import T0, ScriptedCaller, long_decision, load_fix
+++++from engine import state, persistence, recovery, marketdata
+++++
