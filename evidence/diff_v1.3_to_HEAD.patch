+++++++def write_heartbeat(path, t, code_hash, last_boundary):
+++++++    tmp = path + ".tmp"
+++++++    with open(tmp, "w") as f:
+++++++        json.dump({"ts": t, "code_hash": code_hash,
+++++++                   "last_boundary_processed": last_boundary}, f)
+++++++    os.replace(tmp, path)
