++    if os.path.exists(path):
++        return path                      # stable id => duplicate detected, keep first
++    tmp = path + ".tmp"
++    with open(tmp, "w") as f:
++        json.dump(rec, f, indent=1, default=str)
++        f.flush()
++        os.fsync(f.fileno())
++    os.replace(tmp, path)
++    return path
