+++++    assert raw["qty"] != 0 and ta["qty"] != 0          # no decision-generated change
+++++    # post-T replay proceeds for BOTH twins despite the abort
+++++    down = [mk(T0 + i * 60, float(p) * 0.998, float(p) * 0.9985,
