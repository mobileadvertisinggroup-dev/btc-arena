++++    assert r1["counts"]["PAIR_ABORTED"] > 0 and r1["counts"]["PAIR_TERMINAL_SPLIT"] > 0
++++    assert r1["terminal"], "no terminal account"
++++
++++
++++if __name__ == "__main__":
++++    main()
