++                           {"boundary": None, "official": True,
++                            "created": stamp})
++    print(f"pilot archived -> {arch}")
++    print(f"18 fresh official accounts written -> {OFFICIAL_STORE}/state.json")
++    print("Official 14-day experiment NOT started (separate authorization).")
