++++
++++def inv_for(pos, p):
++++    return {"timeframe": "1m_intrabar",
++++            "operator": "price_at_or_below" if pos == "long" else "price_at_or_above",
++++            "level": float(p * (Decimal("0.8") if pos == "long" else Decimal("1.2")))}
