+++++++
+++++++def load_fix(coin, tf):
+++++++    with open(os.path.join(FIX, f"{coin.lower()}_{tf}.json")) as f:
+++++++        return json.load(f)
+++++++
+++++++
+++++++@pytest.fixture(scope="session")
+++++++def cfg():
