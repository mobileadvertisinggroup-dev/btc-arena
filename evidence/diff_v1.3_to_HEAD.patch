++    lc = a["lifecycle"]
++    assert lc["triggered"] is not None and a["qty"] != 0
++    inc = {"position": "long", "size_usd": 8000, "stop_loss": None, "take_profit": None,
++           "thesis": "doubling down", "invalidation": None, "watch_condition": None}
