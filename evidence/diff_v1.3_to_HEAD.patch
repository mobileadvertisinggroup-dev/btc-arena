+# ---- 2. persisted marks + equity history through the real pilot ----
+
+def _sol_price():
+    snap = marketdata.build_snapshot("SOL", load_fix("SOL", "1m"),
+                                     load_fix("SOL", "1h"),
+                                     load_fix("SOL", "1d"), T0)
