++++def check_invariants(a, coin):
++++    for k in ("E", "fees_total"):
++++        assert a[k].is_finite() and a[k] >= 0
++++    assert a["qty"].is_finite()
++++    assert a["qty"] == a["qty"].quantize(QTY_Q[coin])          # precision respected
++++    if a["qty"] == 0:
