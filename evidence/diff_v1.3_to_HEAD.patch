++def _script_mod():
++    path = os.path.join(config.ROOT, "scripts", "run_pilot_12h.py")
++    spec = importlib.util.spec_from_file_location("run_pilot_12h_ut", path)
++    mod = importlib.util.module_from_spec(spec)
++    spec.loader.exec_module(mod)
++    return mod
