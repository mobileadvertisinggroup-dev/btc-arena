+:root{
+  --paper:#f2f2f0; --panel:#fcfcfb; --ink:#141414; --mut:#66665f;
+  --rule:#141414; --hair:#e0e0db;
+  --haiku:#2a78d6; --sonnet:#158f63; --opus:#c47600;
+  --up:#0a7a2f; --down:#c22f26; --demo:#b3261e; --stale:#a86a00;
+  --chrome:#e9e8e2; --tint-haiku:#eef4fc; --tint-sonnet:#edf7f1; --tint-opus:#fdf4e7;
+}
+*{box-sizing:border-box;margin:0}
+html{scroll-behavior:smooth}
+body{background:var(--paper);color:var(--ink);
+  font:14.5px/1.55 ui-monospace,"SF Mono",Menlo,Consolas,"Courier New",monospace}
+a{color:var(--ink)}
+.wrap{max-width:1360px;margin:0 auto;padding:0 22px}
+/* banners */
+.prep{background:var(--ink);color:var(--paper);text-align:center;font-weight:700;
+  letter-spacing:1.5px;padding:10px 12px;font-size:13px}
+.notice{text-align:center;color:var(--mut);font-size:12.5px;padding:7px 12px;
+  background:var(--panel);border-bottom:1px solid var(--hair)}
+.demoflag{display:none;background:var(--demo);color:#fff;text-align:center;
+  font-weight:800;letter-spacing:2px;padding:9px;position:sticky;top:0;z-index:40}
+body.demo .demoflag{display:block}
+/* masthead */
+.top{border-bottom:3px solid var(--rule);background:var(--paper);
+  position:sticky;top:0;z-index:30}
+.mast{display:flex;justify-content:space-between;align-items:center;
+  padding:14px 0;gap:14px;flex-wrap:wrap}
+.brand .t1{font-size:32px;font-weight:800;letter-spacing:3px;line-height:1}
+.brand .t2{font-size:12.5px;letter-spacing:3px;color:var(--mut);margin-top:4px}
+.brand .t2 b{color:var(--ink)}
+nav{display:flex;gap:4px;flex-wrap:wrap}
+nav a{font-size:12px;letter-spacing:1px;text-decoration:none;padding:6px 11px}
+nav a:hover{background:var(--ink);color:var(--paper)}
+/* DISPLAY-ONLY MARKET TICKER — NON-AUTHORITATIVE (styles) */
+.strip{display:grid;grid-template-columns:repeat(3,1.35fr) repeat(3,1fr);
+  border:1px solid var(--hair);border-top:none;background:var(--panel)}
+.cell{padding:13px 18px;border-right:1px solid var(--hair)}
+.cell:last-child{border-right:none}
+.cell .l{font-size:10.5px;letter-spacing:1.5px;color:var(--mut)}
+.cell .v{font-weight:700;font-size:15px;margin-top:3px}
+.cell.mkt .v{font-size:24px;font-weight:800;letter-spacing:.5px}
+.cell.mkt .sub{font-size:10.5px;color:var(--mut);margin-top:2px}
+.cell.mkt .dot{display:inline-block;width:7px;height:7px;border-radius:50%;
+  background:#3fa34d;margin-right:7px;vertical-align:2px}
+.cell.mkt.stale .dot{background:var(--stale)}
+.cell.mkt.dead .dot{background:#999}
+.ticker-note{grid-column:1/-1;color:var(--mut);font-size:10.5px;padding:6px 18px;
+  border-top:1px solid var(--hair);background:var(--paper)}
+/* layout */
+.main{display:grid;grid-template-columns:1.72fr 1fr;gap:22px;margin:22px 0;
+  align-items:start}
+/* main-stage chart */
+.stage{border:1px solid var(--hair);background:var(--panel)}
+.stagebar{background:var(--chrome);color:var(--ink);display:flex;
+  justify-content:space-between;align-items:center;padding:10px 16px;
+  flex-wrap:wrap;gap:8px;border-bottom:1px solid var(--hair)}
+.stagebar .title{font-weight:800;letter-spacing:1.5px;font-size:15px}
+.stagebar .tf{font-size:11px;color:var(--mut);letter-spacing:1px}
+.metrics{display:flex;gap:4px;flex-wrap:wrap}
+.metrics button,.demo-btn{font:inherit;font-size:11.5px;letter-spacing:1px;
+  background:var(--panel);color:var(--mut);border:1px solid var(--hair);
+  padding:5px 12px;cursor:pointer;border-radius:3px}
+.metrics button.active{background:var(--ink);color:var(--paper);
+  border-color:var(--ink);font-weight:700}
+.demo-btn{color:var(--mut)}
+body.demo .demo-btn{background:var(--demo);border-color:var(--demo);color:#fff}
+.coin-tabs{display:flex;border-bottom:1px solid var(--hair);background:var(--chrome)}
+.coin-tabs .tab{padding:10px 22px;cursor:pointer;font-weight:700;font-size:12.5px;
+  letter-spacing:1.5px;color:var(--mut);border-bottom:3px solid transparent}
+.coin-tabs .tab.active{background:var(--panel);color:var(--ink);
+  border-bottom-color:var(--ink)}
+.chart-inner{padding:16px}
+#chartwrap{position:relative}
+#chartmsg{position:absolute;inset:0;display:flex;align-items:center;
+  justify-content:center;color:var(--mut);letter-spacing:3px;font-size:16px;
+  pointer-events:none}
+#tip{position:absolute;display:none;background:var(--ink);color:var(--paper);
+  font-size:12px;padding:7px 10px;pointer-events:none;z-index:5;white-space:nowrap}
+.legend{display:flex;gap:18px;flex-wrap:wrap;font-size:12px;color:var(--mut);
+  margin-top:10px}
+.legend .sw{display:inline-block;width:26px;height:0;border-top:3px solid;
+  vertical-align:middle;margin-right:6px}
+.legend .dash{border-top-style:dashed}
+/* right panel */
+.panel{border:1px solid var(--hair);background:var(--panel);display:flex;
+  flex-direction:column;max-height:calc(100vh - 130px);position:sticky;top:104px}
+.panel-tabs{display:flex;border-bottom:1px solid var(--hair);background:var(--chrome)}
+.panel-tabs .ptab{flex:1;text-align:center;padding:11px 4px;cursor:pointer;
+  font-size:11px;font-weight:700;letter-spacing:.5px;color:var(--mut);
+  border-bottom:3px solid transparent}
+.panel-tabs .ptab.active{background:var(--panel);color:var(--ink);
+  border-bottom-color:var(--ink)}
+.panel-filters{display:flex;gap:6px;padding:10px 12px;border-bottom:1px solid var(--hair)}
+.panel-filters select{font:inherit;font-size:12px;background:var(--paper);
+  border:1px solid var(--hair);padding:4px 6px;flex:1}
+.plist{overflow-y:auto;padding:14px}
+/* cards */
+.chatrow{display:flex;gap:10px;margin-bottom:16px;align-items:flex-start}
+.chatrow .icon{margin-top:4px}
+.mcard{border:1px solid rgba(20,20,20,.12);background:#fff;flex:1;
+  margin-bottom:0;cursor:pointer;border-radius:6px;
+  box-shadow:0 1px 2px rgba(20,20,20,.05)}
+.mcard.tint-haiku{background:var(--tint-haiku)}
+.mcard.tint-sonnet{background:var(--tint-sonnet)}
+.mcard.tint-opus{background:var(--tint-opus)}
+.mcard.arm-ta{border-style:dashed}
+.mcard .mhead{display:flex;align-items:baseline;gap:10px;padding:12px 14px 0}
+.icon{width:26px;height:26px;flex:none;display:flex;align-items:center;
+  justify-content:center;color:#fff;font-weight:800;font-size:13px}
+.icon.haiku{background:var(--haiku);clip-path:polygon(50% 0,100% 100%,0 100%)}
+.icon.sonnet{background:var(--sonnet);border-radius:50%}
+.icon.opus{background:var(--opus)}
+.mcard .who{font-size:15px;font-weight:800}
+.mcard .sub{font-size:11.5px;color:var(--mut)}
+.mcard .stpill{margin-left:auto;font-size:10px;font-weight:800;letter-spacing:1px;
+  padding:3px 9px;border:1.5px solid}
+.stpill.waiting{color:var(--mut);border-color:var(--mut)}
+.stpill.thinking{color:var(--stale);border-color:var(--stale);
+  animation:pulse 1.2s infinite}
+.stpill.decision{color:var(--up);border-color:var(--up)}
+@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
+.mcard .thesis{font-size:15px;line-height:1.6;padding:10px 14px 12px}
+.dstrip{display:flex;gap:14px;flex-wrap:wrap;border-top:1px solid rgba(20,20,20,.08);
+  padding:9px 14px;font-size:12.5px;color:var(--mut);align-items:center}
+.dir{border-radius:3px}
+.dstrip .dir{font-weight:800;font-size:13px;padding:2px 10px;color:#fff}
+.dir.long{background:var(--up)} .dir.short{background:var(--down)}
+.dir.flat{background:var(--mut)}
+.dstrip b{color:var(--ink)}
+.expand-hint{font-size:10.5px;color:var(--mut);text-align:right;padding:0 14px 8px}
+.xtra{display:none;border-top:1px dashed var(--hair);padding:10px 14px;
+  font-size:12.5px;color:var(--mut)}
+.xtra b{color:var(--ink)}
+.mcard.open .xtra{display:block}
+/* trade cards */
+.tcard{border:1px solid rgba(20,20,20,.12);border-left:5px solid;background:#fff;
+  margin-bottom:14px;padding:12px 14px;border-radius:6px;
+  box-shadow:0 1px 2px rgba(20,20,20,.05)}
+.tcard .row1{display:flex;align-items:center;gap:10px}
+.tcard .pnl{margin-left:auto;font-size:19px;font-weight:800}
