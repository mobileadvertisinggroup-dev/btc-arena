++
++    def fetch():
++        t = served.pop(0)
++        if not t:
++            raise OSError("HTTP 404")
++        return t
++    out = mod.poll_public("7:READY:0", fetch, clock, clock.sleep,
++                          timeout=300, interval=15)
++    assert "7:READY:0" in out
++    assert clock.t == 30                             # two waits, then success
++
