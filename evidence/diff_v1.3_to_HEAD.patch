+++++def mk(t, o, h, l, c, v=1):
+++++    return {"t": t, "o": Decimal(str(o)), "h": Decimal(str(h)),
+++++            "l": Decimal(str(l)), "c": Decimal(str(c)), "v": Decimal(str(v))}
