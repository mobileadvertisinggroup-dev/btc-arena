++++HOUR = 3600
++++N_BOUNDARIES = 72
++++cfg = config.load_config()
++++K = {c: {tf: load_fix(c, tf) for tf in ("1m", "1h", "1d")} for c in ("BTC", "ETH", "SOL")}
