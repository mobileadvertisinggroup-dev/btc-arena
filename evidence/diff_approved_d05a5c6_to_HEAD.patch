+    _boundary2(store, cfg, mk_candles(T0, 60, p, dip_to=stop * 0.999))
+    arch = persistence.read_prompt_archive(store, f"v1-ALL-{T1}")
+    for aid in ("sol_haiku_raw", "sol_haiku_ta"):    # Raw AND TA corrected
