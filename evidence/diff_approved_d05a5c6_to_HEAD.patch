+                  "(pristine accounts verified). ARMED/OFF; rearm cleanly.")
+            kind = "no_schedule"
+    if kind != "no_schedule":
+        # MANDATORY durable trust validation (Ruling 018.3) — before the
+        # COMPLETE report, before resume, before unstarted reconciliation
