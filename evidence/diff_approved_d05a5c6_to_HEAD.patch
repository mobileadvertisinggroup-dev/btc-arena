+# ---- 016.1 causal live event order (CRITICAL) ----
+
+def test_prior_hour_stop_hit_makes_T_prompt_flat(cfg):
+    p = float(_sol_price())
+    store = _open_sol_positions(cfg, long_decision(p, 2000))
